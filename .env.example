# Copy this file to .env.local and fill it in. .env.local is gitignored.
# Never prefix secrets with NEXT_PUBLIC_: that bundles them into browser JavaScript.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Check which models your key can use with: npm run models
# Free tier quotas are per model, about 20 requests/day on the main Flash model,
# and one full interview uses ~13. For development, a lite model such as
# gemini-3.1-flash-lite has its own separate quota.
GEMINI_MODEL=gemini-3.5-flash
